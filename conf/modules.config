/*
~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
    Config file for defining DSL2 per module options and publishing paths
~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
    Available keys to override module options:
        ext.args   = Additional arguments appended to command in module.
        ext.args2  = Second set of arguments appended to command in module (multi-tool modules).
        ext.args3  = Third set of arguments appended to command in module (multi-tool modules).
        ext.prefix = File name prefix for output files.
----------------------------------------------------------------------------------------
*/

process {

    // Output layout:
    //   - 3-token process path GROUPX:SUBWORKFLOW:PROCESS
    //       -> ${outdir}/groupX/<subworkflow>/<tool>/
    //   - 2-token process path GROUPX:PROCESS
    //       -> ${outdir}/groupX/<tool>/
    //   - <tool> is the prefix of the process name before the first underscore
    //   - pipeline_info/ is written by Nextflow itself at ${outdir} root.
    
    publishDir = [
        path: {
            def t     = task.process.tokenize(':')
            def group = t[0].replaceFirst(/^GROUP/, 'group')
            def tool  = t[-1].tokenize('_')[0].toLowerCase()
            def subwf = t.size() >= 3 ? t[1].toLowerCase() : null
            return subwf ? "${params.outdir}/${group}/${subwf}/${tool}"
                         : "${params.outdir}/${group}/${tool}"
        },
        mode: params.publish_dir_mode,
        saveAs: { filename -> filename.equals('versions.yml') ? null : filename }
    ]

    withName: FASTQC {
        ext.args = '--quiet'
    }

    withName: 'MULTIQC' {
        ext.args = { params.multiqc_title ? "--title \"$params.multiqc_title\"" : '' }
    }

    // Per-sample prefix so collected seqtab.rds files don't collide at merge time.
    // Retry transient failures up to 2x, then ignore so the channel.join() downstream drops the sample.
    withName: 'DADA2_DENOISING' {
        ext.prefix    = { "${meta.id}" }
        errorStrategy = { task.attempt <= 2 ? 'retry' : 'ignore' }
        maxRetries    = 2
    }

    // Retry transient failures up to 2x, then ignore so the join() in the taxonomic_profiling
    // subworkflow drops the sample and downstream merge sees only survivors.
    withName: 'DADA2_FILTNTRIM' {
        errorStrategy = { task.attempt <= 2 ? 'retry' : 'ignore' }
        maxRetries    = 2
    }
    withName: 'DADA2_ERR' {
        errorStrategy = { task.attempt <= 2 ? 'retry' : 'ignore' }
        maxRetries    = 2
    }

}
