conda.enabled = true

params {
    outdir = "results"
}

process {
    withName: 'get_sampling_depth' {
        conda  = '/data/upfagb/.conda/envs/qiime2-amplicon-2026.1'
        cpus   = 1
        memory = '4 GB'
        time   = '30 m'
    }
    withName: 'diversity_analysis' {
        conda  = '/data/upfagb/.conda/envs/qiime2-amplicon-2026.1'
        cpus   = 4
        memory = '8 GB'
        time   = '2 h'
        publishDir = [
            path: { "${params.outdir}" },
            mode: 'copy'
        ]
    }
}
